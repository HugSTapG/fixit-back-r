generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("PAYMENT_DATABASE_URL")
}

// Enums
enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO

  @@map("metodo_pago")
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO

  @@map("estado_pago")
}

// Modelo principal del microservicio Payment
model Transaccion {
  idTransaccion Int         @id @default(autoincrement())
  idSolicitud   Int         // Referencia externa - sin foreign key constraint
  monto         Decimal     @db.Decimal(10, 2)
  metodoPago    MetodoPago
  estadoPago    EstadoPago  @default(PENDIENTE)
  fechaPago     DateTime?
  referencia    String?     @db.VarChar(100)
  notas         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("transacciones")
}